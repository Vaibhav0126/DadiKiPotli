# Module 1 - script. Free tier (~1500 req/day): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Module 3a - images (preferred). Free 10k neurons/day, no card needed.
# Account ID: https://dash.cloudflare.com/ (right sidebar)
# API token:  https://dash.cloudflare.com/profile/api-tokens  (Workers AI template)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Module 3a - images (fallback). Only used when images.provider: pollinations
# https://enter.pollinations.ai
POLLINATIONS_TOKEN=

# Module 3b - image-to-video. Only needed when motion.enabled is true;
# --no-motion skips it entirely. https://fal.ai/dashboard/keys
FAL_KEY=

# Module 5 - publish (only needed with --publish)
# YouTube Data API OAuth. Create a desktop OAuth client, enable YouTube Data API v3,
# download the JSON, then run: python -m tools.auth_youtube
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_PATH=secrets/youtube_token.json
